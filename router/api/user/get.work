name: api
version: 1
work:
  - sql:
      as: user
      select: 
        - "email" 
        - "username"
      from: user
      where:
        is_active: true
      offset: 0
      limit: 30

 
success: 
  - return: 
      json:
        success: true
        data: "{{ user | json }}"

error: 
  - return: 
      json:
        success: false
